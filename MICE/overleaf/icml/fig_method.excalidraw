  {
   "type": "text",
   "id": "code_txt",
   "x": 56,
   "y": 614,
   "width": 320,
   "height": 122,
   "text": "# batch t, labels of t-1 are in\nw[k] ~ exp(-10 * logloss_k[t-1])\np_1  = sum_k w[k] * p_k\n\nL[j] = 0.9 * L[j] + brier_j[t-1]\nv[j] ~ exp(-0.5 * 0.9 * L[j])\np_t  = v[0] * p_0 + v[1] * p_1",
   "originalText": "# batch t, labels of t-1 are in\nw[k] ~ exp(-10 * logloss_k[t-1])\np_1  = sum_k w[k] * p_k\n\nL[j] = 0.9 * L[j] + brier_j[t-1]\nv[j] ~ exp(-0.5 * 0.9 * L[j])\np_t  = v[0] * p_0 + v[1] * p_1",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#22c55e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
